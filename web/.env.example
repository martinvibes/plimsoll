# JSON Ledger API of the participant hosting the demo parties.
PLIMSOLL_LEDGER_URL=http://localhost:7575
PLIMSOLL_NETWORK=Canton sandbox
# Parties written by `make seed` (defaults to ../.plimsoll/cast.json).
# PLIMSOLL_CAST_FILE=../.plimsoll/cast.json
# Authenticated ledgers: a fixed token, or a Keycloak token file plus refresh settings.
# PLIMSOLL_LEDGER_TOKEN=
# PLIMSOLL_LEDGER_TOKEN_FILE=.plimsoll/devnet.token.json
# PLIMSOLL_OIDC_TOKEN_URL=
# PLIMSOLL_OIDC_CLIENT_ID=
# PLIMSOLL_LEDGER_USER=
# Canton Coin settles through the token-standard registry API.
# PLIMSOLL_REGISTRY_URL=
